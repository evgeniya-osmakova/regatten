generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResultImportStatus {
  NOT_STARTED
  SKIPPED_NOT_COMPLETED
  IMPORTED
  MISSING_RESULT_LINK
  EVENT_ID_UNRESOLVED
  RESULT_FETCH_FAILED
  RESULT_SAVE_FAILED
  INVALID_RESULT_JSON
  NO_ENTRIES
}

model Regatta {
  id                 String @id

  year               Int
  level              String
  regionName         String @map("region_name")

  name               String
  dateFrom           DateTime @db.Date @map("date_from")
  dateTo             DateTime @db.Date @map("date_to")
  location           String?

  canceled           Int
  boats              Int

  clubId             String? @map("club_id")
  club               Club? @relation(fields: [clubId], references: [id])

  runsTotal          Int? @map("runs_total")
  runsScored         Int? @map("runs_scored")
  factor             Float?

  resultLink         String? @map("result_link")

  /// Manage2Sail event UUID resolved from the DODV result link.
  eventId            String? @map("event_id")
  /// Manage2Sail regatta/result UUID resolved from the DODV classId or alias.
  classId            String? @map("class_id")

  isCompleted        Boolean @map("is_completed")
  status             ResultImportStatus @default(NOT_STARTED)

  results            RegattaResult[]
  raceResults        RaceResult[]

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([year])
  @@index([regionName])
  @@index([isCompleted])
  @@index([status])
  @@index([clubId])
  @@map("regattas")
}

model Sailor {
  id                   String @id

  name                  String
  normalizedName        String @map("normalized_name")
  sailNumber            String @map("sail_number")
  sailNumberNormalized  String @map("sail_number_normalized")

  clubName              String? @map("club_name")
  clubCode              String? @map("club_code")
  isTracked             Boolean @default(false) @map("is_tracked")

  results               RegattaResult[]
  raceResults           RaceResult[]

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([normalizedName])
  @@index([sailNumberNormalized])
  @@index([isTracked])
  @@map("sailors")
}

model Club {
  id              String @id
  name            String
  code            String?
  url             String?

  regattas        Regatta[]
  regattaResults  RegattaResult[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@map("clubs")
}

model RegattaResult {
  id             String @id @default(cuid())

  regattaId      String @map("regatta_id")
  regatta        Regatta @relation(fields: [regattaId], references: [id], onDelete: Cascade)

  sailorId       String @map("sailor_id")
  sailor         Sailor @relation(fields: [sailorId], references: [id])

  rank           Int?
  totalPoints    Float? @map("total_points")
  netPoints      Float? @map("net_points")

  clubId         String? @map("club_id")
  club           Club? @relation(fields: [clubId], references: [id])

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([regattaId, sailorId])
  @@index([sailorId])
  @@index([rank])
  @@index([clubId])
  @@map("regatta_results")
}

model RaceResult {
  id                      String @id @default(cuid())

  regattaId               String @map("regatta_id")
  regatta                 Regatta @relation(fields: [regattaId], references: [id], onDelete: Cascade)

  sailorId                String @map("sailor_id")
  sailor                  Sailor @relation(fields: [sailorId], references: [id])

  raceIndex                Int @map("race_index")
  rank                     Int?
  points                   Float?
  pointsDiscarded          Boolean @default(false) @map("points_discarded")
  raceStatusCode           String? @map("race_status_code")

  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@unique([regattaId, sailorId, raceIndex])
  @@index([raceStatusCode])
  @@index([sailorId])
  @@map("race_results")
}
